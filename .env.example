# Freshdesk · Kapa AI Integration — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ─── Freshdesk ────────────────────────────────────────────────
# Your Freshdesk subdomain (e.g. yourcompany if your URL is yourcompany.freshdesk.com)
FRESHDESK_SUBDOMAIN=

# Freshdesk API key — found in Profile Settings > API Key
FRESHDESK_API_KEY=

# Agent or group ID to reassign non-English tickets to
FRESHDESK_REASSIGN_AGENT_ID=

# Tag name applied to AI-handled tickets
FRESHDESK_AI_HANDLED_TAG=ai-handled

# ─── Kapa AI ──────────────────────────────────────────────────
# Kapa AI API key — found in your Kapa dashboard
KAPA_API_KEY=

# Kapa AI project/bot identifier
KAPA_PROJECT_ID=
